APP_NAME=evolution-helpdesk-middleware
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8090

POSTGRES_USER=middleware_user
POSTGRES_PASSWORD=middleware_pass
POSTGRES_DB=middleware_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://middleware_user:middleware_pass@localhost:5432/middleware_db

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=evolution_exchange
RABBITMQ_QUEUE_IN=middleware.evolution.events
RABBITMQ_QUEUE_OUT=evolution.middleware.out
RABBITMQ_ROUTING_KEY_IN=#
RABBITMQ_ROUTING_KEY_OUT=helpdesk.out

EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_API_TIMEOUT=20

SUPPORT_WHATSAPP_NUMBER=

# Helpdesk backend (schema-per-tenant, /api/v2). The base URL MUST include /api/v2.
HELPDESK_API_BASE_URL=http://host.containers.internal:8000/api/v2
HELPDESK_API_TIMEOUT=30
# JSON map: helpdesk tenant slug -> that tenant's integration API key (scopes read,write).
# Generate per tenant in the helpdesk: POST /api/v2/integration/api-key?scopes=read,write
HELPDESK_TENANT_API_KEYS={"acme":"hd_xxx"}
# Production resolves tenants by Host subdomain: set to the platform suffix (e.g. .mitra.mw)
# so requests carry X-Forwarded-Host: <slug>.mitra.mw. Leave empty for local dev, where the
# helpdesk needs TENANCY_ENABLE_HEADER_FALLBACK=true and reads X-Tenant-ID.
HELPDESK_TENANT_DOMAIN_SUFFIX=

# Optional bootstrap of a first tenant + Evolution instance link
DEFAULT_TENANT_NAME=
DEFAULT_TENANT_SLUG=
DEFAULT_INSTANCE_NAME=

# Secret used only to validate admin JWTs on this middleware's own management API. No default.
SECRET_KEY=
